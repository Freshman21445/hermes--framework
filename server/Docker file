FROM golang:1.20-alpine AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o hermes-server .

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /root/
COPY --from=build /app/hermes-server .
COPY --from=build /app/web ./web
EXPOSE 443 53 80
CMD ["./hermes-server"]
